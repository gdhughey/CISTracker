function openMakeReservationFlow() {
  const eligible = (ITEMS || []).filter(i => i.status !== 'retired' && i.status !== 'deleted');
  const cats = [...new Set(eligible.map(i => i.category || i.category_name).filter(Boolean))].sort();
  const locs = [...new Set(eligible.map(i => i.location).filter(Boolean))].sort();
  let _resPickCat = '', _resPickLoc = '';
  const _resSel = new Set();

  function updateSelBar() {
    const bar = document.getElementById('resSelBar');
    const btn = document.getElementById('resSelBtn');
    if (!bar || !btn) return;
    const n = _resSel.size;
    bar.style.display = n ? 'flex' : 'none';
    btn.textContent = `Reserve ${n} item${n !== 1 ? 's' : ''} →`;
  }

  function renderPickList() {
    const q = (document.getElementById('resPickSearch')?.value || '').toLowerCase();
    const matches = eligible.filter(i => {
      if (_resPickCat && (i.category || i.category_name) !== _resPickCat) return false;
      if (_resPickLoc && i.location !== _resPickLoc) return false;
      if (q && !i.name.toLowerCase().includes(q) && !(i.category || i.category_name || '').toLowerCase().includes(q)) return false;
      return true;
    });
    const el = document.getElementById('resPickList');
    if (!el) return;
    if (!matches.length) { el.innerHTML = '<div style="color:var(--text-muted);padding:12px 0;text-align:center">No items found.</div>'; return; }
    el.innerHTML = matches.map(i => {
      const sel = _resSel.has(i.id);
      return `<div class="res-pick-item${sel ? ' res-pick-selected' : ''}" data-res-id="${i.id}"
          onclick="window._resToggle(${i.id})"
          style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:6px;cursor:pointer;border:1px solid ${sel ? 'var(--accent)' : 'var(--border)'};background:${sel ? 'var(--accent-faint)' : 'transparent'}">
        <input type="checkbox" ${sel ? 'checked' : ''} onclick="event.stopPropagation();window._resToggle(${i.id})" style="flex-shrink:0;cursor:pointer;width:16px;height:16px">
        <div style="flex:1;min-width:0">
          <div style="font-weight:500;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(i.name)}</div>
          <div style="font-size:11px;color:var(--text-muted)">${[i.category||i.category_name, i.location].filter(Boolean).join(' · ')}</div>
        </div>
        <span class="status-badge status-${esc(i.status)}" style="font-size:11px;padding:2px 6px;flex-shrink:0">${esc(i.status)}</span>
      </div>`;
    }).join('');
  }

  const catChips = ['', ...cats].map(c =>
    `<button class="chip${_resPickCat===c?' active':''}" style="font-size:11px" onclick="window._resSetCat(${JSON.stringify(c)})">${c || 'All'}</button>`
  ).join('');
  const locChips = ['', ...locs].map(l =>
    `<button class="chip${_resPickLoc===l?' active':''}" style="font-size:11px" onclick="window._resSetLoc(${JSON.stringify(l)})">${l || 'All'}</button>`
  ).join('');

  showModal(`
    <div class="modal-title">Reserve Equipment</div>
    <div class="modal-body" style="margin-top:8px">
      <input type="text" id="resPickSearch" class="form-input" placeholder="Search by name…" oninput="window._resRender()" autocomplete="off" style="margin-bottom:8px">
      ${cats.length ? `<div style="font-size:11px;color:var(--text-muted);margin-bottom:3px">Category</div><div class="filter-chips" id="resCatChips" style="margin-bottom:8px">${catChips}</div>` : ''}
      ${locs.length ? `<div style="font-size:11px;color:var(--text-muted);margin-bottom:3px">Location</div><div class="filter-chips" id="resLocChips" style="margin-bottom:10px">${locChips}</div>` : ''}
      <div id="resPickList" style="max-height:240px;overflow-y:auto;display:flex;flex-direction:column;gap:5px"></div>
    </div>

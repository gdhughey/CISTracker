function stopRefreshInterval() {
  if (_refreshInterval) { clearInterval(_refreshInterval); _refreshInterval = null; }
}

// ── Broadcast banner ───────────────────────────────────────────────────
let _broadcastInterval = null;
let _lastBroadcastMsg = null;
let _dismissedBroadcast = null;

function startBroadcastPoll() {
  if (_broadcastInterval) clearInterval(_broadcastInterval);
  pollBroadcast();
  _broadcastInterval = setInterval(pollBroadcast, 20000);
}

async function pollBroadcast() {
  try {
    const data = await fetch('/api/broadcast').then(r => r.json());
    const msg = data?.message || null;
    const dismissed = sessionStorage.getItem('dismissedBroadcast');
    if (msg && msg === dismissed) return;
    if (msg !== _lastBroadcastMsg) {
      _lastBroadcastMsg = msg;
      renderBroadcastBanner(msg);
    }
  } catch {}
}

function renderBroadcastBanner(msg) {
  let banner = document.getElementById('broadcastBanner');
  if (!msg) { if (banner) banner.remove(); return; }
  if (!banner) {
    banner = document.createElement('div');
    banner.id = 'broadcastBanner';
    banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;background:var(--warning,#f59e0b);color:#1a1a00;padding:10px 48px 10px 16px;font-size:13px;font-weight:600;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.3);line-height:1.4';
    const close = document.createElement('button');
    close.textContent = '✕';
    close.style.cssText = 'position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;font-size:16px;cursor:pointer;color:inherit;padding:0 4px;opacity:0.7';
    close.onclick = () => {
      try { sessionStorage.setItem('dismissedBroadcast', _lastBroadcastMsg || ''); } catch {}
      _dismissedBroadcast = _lastBroadcastMsg;
      banner.remove();
    };
    banner.appendChild(close);
    document.body.prepend(banner);
  }
  const close = banner.querySelector('button');
  banner.textContent = '📢 ' + msg;
  if (close) banner.appendChild(close);
}


// ── App init ───────────────────────────────────────────────────────────
async function showApp() {
  document.getElementById('loginPage').classList.add('hidden');
  document.getElementById('changePwPage').classList.add('hidden');
  document.getElementById('appLayout').classList.remove('hidden');
  // Set user info in sidebar
  document.getElementById('userName').textContent = ME.username;
  document.getElementById('userRole').textContent = ME.role;
  document.getElementById('userAvatar').textContent = ME.username[0].toUpperCase();
  // Admin features
  if (ME.role === 'admin' || ME.role === 'owner') {
    document.getElementById('adminNav').style.display = '';
    document.getElementById('addItemBtn').style.display = '';
  }
  if (ME && (ME.role === 'admin' || ME.role === 'owner')) {
    const mdb = document.getElementById('massDeleteBtn');
    if (mdb) mdb.style.display = '';
  }
  // Load data
  initTableScroll();
  loadPeriodSettings();
  const isAdminOrOwner = ME.role === 'admin' || ME.role === 'owner';
  const adminLoads = isAdminOrOwner ? [loadOverdueCount(), loadTicketCounts(), loadSvcTicketBadge()] : [];
  await Promise.all([loadItems(), updateQueueBadge(), ...adminLoads]);
  switchView('inventory');
  // Keep session alive — silent ping every 4 minutes so idle users aren't logged out
  setInterval(() => api('/api/auth/me').catch(() => {}), 4 * 60 * 1000);
  // Broadcast banner poll
  startBroadcastPoll();
  // Inject broadcast button for admins/owners
  if (isMeAdmin()) {
    const adminNav = document.getElementById('adminNav');
    if (adminNav && !document.getElementById('broadcastNavBtn')) {
      const btn = document.createElement('button');
      btn.id = 'broadcastNavBtn';
      btn.className = 'nav-item';
      btn.innerHTML = '📢 Broadcast';
      btn.style.cssText = 'width:100%;text-align:left;background:none;border:none;cursor:pointer;padding:8px 12px;font-size:13px;color:var(--text-muted);border-radius:8px;margin-top:4px';
      btn.onmouseenter = () => btn.style.background = 'var(--bg-card)';
      btn.onmouseleave = () => btn.style.background = 'none';
      btn.onclick = openBroadcastModal;
      adminNav.appendChild(btn);
    }
  }
  // First-time onboarding tour — only fires once per user/browser
  maybeStartTour();
}


// Shared label printer — 40mm × 30mm thermal stock (landscape).
// Pass the label API response object plus item metadata.
function buildLabelsDoc(items) {
  const css = `
    @page{size:40mm 30mm landscape;margin:0;}
    *{box-sizing:border-box;}
    html,body{margin:0;padding:0;}
    .lbl{width:40mm;height:30mm;padding:1mm;display:flex;flex-direction:row;align-items:center;gap:1mm;overflow:hidden;font-family:Arial,sans-serif;}
    .lbl+.lbl{page-break-before:always;}
    .qr{width:20mm;height:20mm;flex-shrink:0;}
    .info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;justify-content:center;}
    .name{font-size:7pt;font-weight:800;line-height:1.2;word-break:break-word;overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;}
    .cid{font-family:monospace;font-size:6pt;font-weight:700;color:#6366f1;letter-spacing:.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .ser{font-family:monospace;font-size:5pt;color:#555;white-space:nowrap;overflow:hidden;}
    .cat{font-size:5pt;color:#777;white-space:nowrap;overflow:hidden;}
  `;
  const body = items.map(it =>
    `<div class="lbl"><img class="qr" src="${it.qr}"><div class="info"><div class="name">${esc(it.name)}</div><div class="cid">${esc(it.id)}</div>${it.serial ? `<div class="ser">${esc(it.serial)}</div>` : ''}${it.category ? `<div class="cat">${esc(it.category)}</div>` : ''}</div></div>`
  ).join('');
  return `<html><head><style>${css}</style></head><body>${body}</body></html>`;
}

function doPrintLabel(label, name, category, serial) {
  const frame = document.createElement('iframe');
  frame.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:40mm;height:30mm;border:none;';
  document.body.appendChild(frame);
  const doc = frame.contentDocument;
  doc.write(buildLabelsDoc([{qr: label.qr_data_url, id: label.asset_id, name, serial, category}]));
  doc.close();
  setTimeout(() => { frame.contentWindow.print(); setTimeout(() => frame.remove(), 2000); }, 250);
}

function printPendingLabel() {
  if (!_pendingPrint) return;
  const { label, name, category, serial } = _pendingPrint;
  doPrintLabel(label, name, category, serial);
}


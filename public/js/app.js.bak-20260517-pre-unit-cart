async function confirmMassDelete(ids) {
  let failed = 0;
  for (const id of ids) {
    try {
      const r = await api(`/api/equipment/${id}`, { method: 'DELETE' });
      if (!r.ok) failed++;
    } catch { failed++; }
  }
  clearSelection();

function toggleSelect(id, cb, e) {
  const idx = renderVisible.findIndex(it => it.id === id);

  if (e && e.shiftKey && _lastSelectedIdx >= 0 && idx >= 0) {
    e.preventDefault(); // stop browser text-selection on shift+click
    const lo = Math.min(_lastSelectedIdx, idx);
    const hi = Math.max(_lastSelectedIdx, idx);
    const adding = cb.checked;
    for (let i = lo; i <= hi; i++) {
      const itemId = renderVisible[i].id;
      if (adding) _selectedItems.add(itemId);
      else _selectedItems.delete(itemId);
    }
    // Update visible rows directly — no full DOM rebuild needed
    document.querySelectorAll('#itemsBody .row-cb[data-id]').forEach(rowCb => {
      const rowId = parseInt(rowCb.dataset.id, 10);
      const inSel = _selectedItems.has(rowId);
      rowCb.checked = inSel;
      const parentTr = rowCb.closest('tr');
      if (parentTr) parentTr.classList.toggle('row-selected', inSel);
    });
    // Group checkboxes: update indeterminate state
    document.querySelectorAll('#itemsBody tr.group-row input.row-cb').forEach(gcb => {
      const parentTr = gcb.closest('tr');
      const key = parentTr?._groupKey;
      if (!key) return;
      const groupItems = renderVisible.filter(it => getGroupKey(it.name) === key);
      const allSel = groupItems.length > 0 && groupItems.every(it => _selectedItems.has(it.id));
      const someSel = !allSel && groupItems.some(it => _selectedItems.has(it.id));
      gcb.checked = allSel;
      gcb.indeterminate = someSel;
      parentTr.classList.toggle('row-selected', allSel);
    });
  } else {
    if (cb.checked) _selectedItems.add(id);
    else _selectedItems.delete(id);
    const parentTr = cb.closest('tr');
    if (parentTr) parentTr.classList.toggle('row-selected', cb.checked);
  }
  if (idx >= 0) _lastSelectedIdx = idx;
  updateSelectionBar();
}

function toggleGroupSelect(key, cb) {
  const groupItems = renderVisible.filter(it => getGroupKey(it.name) === key);
  for (const it of groupItems) {
    if (cb.checked) _selectedItems.add(it.id);
    else _selectedItems.delete(it.id);
  }
  renderItems();
  updateSelectionBar();
}

function toggleSelectAll(cb) {

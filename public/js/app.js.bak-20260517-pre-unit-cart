      <span id="resSelCount" style="font-size:13px;color:var(--text-muted);flex:1"></span>
      <button class="btn-outline btn-sm" onclick="window._resClearSel()">Clear</button>
      <button class="btn-primary btn-sm" id="resSelBtn" onclick="window._resNext()">Reserve →</button>
    </div>
    <div class="form-actions" style="padding:10px 16px;border-top:1px solid var(--border)">
      <button class="btn-outline" onclick="closeModal()">Cancel</button>
    </div>
  `, { persistent: true });

  window._resRender = renderPickList;
  window._resToggle = (id) => {
    if (_resSel.has(id)) _resSel.delete(id); else _resSel.add(id);
    const el = document.querySelector(`[data-res-id="${id}"]`);
    if (el) {
      const sel = _resSel.has(id);
      el.style.border = `1px solid ${sel ? 'var(--accent)' : 'var(--border)'}`;
      el.style.background = sel ? 'var(--accent-faint)' : 'transparent';
      const cb = el.querySelector('input[type=checkbox]');
      if (cb) cb.checked = sel;
    }
    const countEl = document.getElementById('resSelCount');
    if (countEl) countEl.textContent = `${_resSel.size} selected`;
    updateSelBar();
  };
  window._resClearSel = () => { _resSel.clear(); renderPickList(); updateSelBar(); };
  window._resNext = () => { if (_resSel.size) openBatchReserveModal([..._resSel]); };
  window._resSetCat = (c) => {
    _resPickCat = c;
    document.querySelectorAll('#resCatChips .chip').forEach(b => b.classList.toggle('active', b.textContent === (c||'All')));
    renderPickList();
  };
  window._resSetLoc = (l) => {
    _resPickLoc = l;
    document.querySelectorAll('#resLocChips .chip').forEach(b => b.classList.toggle('active', b.textContent === (l||'All')));
    renderPickList();
  };
  renderPickList();
}


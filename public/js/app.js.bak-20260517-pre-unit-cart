function updateMoveNameSuggestion(itemId) {
  const item = ITEMS.find(i => i.id === itemId);
  if (!item) return;
  const sel = document.getElementById('moveGroupSelect');
  const nameInput = document.getElementById('moveItemName');
  if (!sel || !nameInput) return;
  const targetKey = sel.value;
  if (!targetKey) {
    const stripped = item.name.replace(_openGroupKey, '').replace(/^[\s#\d]+/, '').trim();
    nameInput.value = stripped || item.name;
  } else {
    const numMatch = item.name.match(/^#(\d+)/);
    nameInput.value = numMatch ? `#${numMatch[1]} ${targetKey}` : targetKey;
  }
}

async function confirmMoveItem(itemId) {
  const newName = (document.getElementById('moveItemName')?.value || '').trim();
  if (!newName) { toast('Name cannot be empty', 'error'); return; }
  try {
    await api(`/api/equipment/${itemId}`, { method: 'PUT', body: { name: newName } });
    toast('Item moved', 'success');
    closeModal();
    closeDetail();
    await loadItems();
  } catch (err) { toast(err.error || 'Failed to move item', 'error'); }
}

async function addExistingToGroup(key) {
  const groupItemIds = new Set(_openGroupItems.map(i => i.id));
  const others = ITEMS.filter(i => !groupItemIds.has(i.id)).sort((a, b) => a.name.localeCompare(b.name));
  if (!others.length) { toast('No other items to add', 'info'); return; }
  const optionsHtml = others.map(i => `<option value="${i.id}">${esc(i.name)} (${esc(i.barcode || 'CIS-' + String(i.id).padStart(6,'0'))})</option>`).join('');
  const nextNum = _openGroupItems.reduce((max, i) => { const m = i.name.match(/^#(\d+)/); return m ? Math.max(max, parseInt(m[1])) : max; }, 0) + 1;
  showModal(`
    <div class="modal-title">Add Existing Item to "${esc(key)}"</div>
    <div class="form-group">
      <label class="form-label">Select item</label>
      <select id="addExistingSelect" class="form-input" onchange="updateAddExistingName('${esc(key)}', ${nextNum})">
        <option value="">— Choose an item —</option>
        ${optionsHtml}
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">New name in this group</label>
      <input id="addExistingName" class="form-input" value="#${nextNum} ${esc(key)}" placeholder="e.g. #${nextNum} ${esc(key)}">
      <div style="font-size:11px;color:var(--text-muted);margin-top:4px">This renames the item to fit the group</div>
    </div>
    <div class="form-actions">
      <button class="btn-outline" onclick="closeModal()">Cancel</button>
      <button class="btn-primary" onclick="confirmAddExisting('${esc(key)}')">Add to Group</button>
    </div>
  `, { persistent: true });
}

function updateAddExistingName(key, nextNum) {
  const sel = document.getElementById('addExistingSelect');
  const nameInput = document.getElementById('addExistingName');
  if (!sel || !nameInput || !sel.value) return;
  const item = ITEMS.find(i => i.id === parseInt(sel.value));
  if (!item) return;
  nameInput.value = `#${nextNum} ${key}`;
}

async function confirmAddExisting(key) {
  const selEl = document.getElementById('addExistingSelect');

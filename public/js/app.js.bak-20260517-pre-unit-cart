async function addItemToGroup(templateItem) {
  if (!templateItem) return;
  // Build category/location labels for display
  const cat = CATEGORIES.find(c => c.id === templateItem.category_id);
  const loc = LOCATIONS_LIST.find(l => l.id === templateItem.location_id);
  const groupKey = getGroupKey(templateItem.name);
  // Determine next #N suffix for default name
  const siblings = ITEMS.filter(i => (i.group_key || getGroupKey(i.name)) === groupKey);
  const usedNums = siblings.map(i => {
    const m = i.name.match(/^#(\d+)\s/);
    return m ? parseInt(m[1], 10) : 0;
  });
  const nextNum = Math.max(0, ...usedNums) + 1;
  const defaultName = templateItem.name.replace(/^#\d+\s+/, `#${nextNum} `);

  const catOptions = CATEGORIES.map(c =>
    `<option value="${c.id}" ${c.id === templateItem.category_id ? 'selected' : ''}>${esc(c.name)}</option>`
  ).join('');
  const locOptions = LOCATIONS_LIST.map(l =>
    `<option value="${l.id}" ${l.id === templateItem.location_id ? 'selected' : ''}>${esc(l.name)}</option>`
  ).join('');

  showModal(`
    <div class="modal-title">Add New Item to Group</div>
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:14px">Group: <strong style="color:var(--text)">${esc(groupKey)}</strong></div>
    <div class="form-group">
      <label class="form-label">Item Name</label>
      <input id="addGrpName" class="form-input" value="${esc(defaultName)}" placeholder="e.g. #${nextNum} ${esc(groupKey)}">
    </div>
    <div class="form-group">
      <label class="form-label">Category</label>
      <select id="addGrpCategory" class="form-input">
        <option value="">— None —</option>
        ${catOptions}
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Location</label>
      <select id="addGrpLocation" class="form-input">
        <option value="">— None —</option>
        ${locOptions}
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Serial / Asset Tag <span style="color:var(--text-muted);font-weight:400">(optional)</span></label>
      <input id="addGrpSerial" class="form-input" placeholder="Serial number or asset tag">
    </div>
    <div class="form-group">
      <label class="form-label">Barcode / CIS# <span style="color:var(--text-muted);font-weight:400">(leave blank to auto-generate)</span></label>
      <input id="addGrpBarcode" class="form-input" placeholder="Auto-generated if blank">
    </div>
    <div class="form-group">
      <label class="form-label">Notes <span style="color:var(--text-muted);font-weight:400">(optional)</span></label>
      <textarea id="addGrpNotes" class="form-input" rows="2" placeholder="Any notes about this item" style="resize:vertical"></textarea>
    </div>
    <div class="form-actions">
      <button class="btn-outline" onclick="closeModal()">Cancel</button>
      <button class="btn-primary" onclick="submitAddItemToGroup(${templateItem.id})">Add Item</button>
    </div>
  `, { persistent: true });
}

async function submitAddItemToGroup(templateId) {
  const templateItem = ITEMS.find(i => i.id === templateId);
  if (!templateItem) return;
  const nameEl = document.getElementById('addGrpName');
  const serialEl = document.getElementById('addGrpSerial');
  const barcodeEl = document.getElementById('addGrpBarcode');
  const notesEl = document.getElementById('addGrpNotes');
  const name = nameEl?.value?.trim();
  if (!name) { toast('Item name is required', 'error'); nameEl?.focus(); return; }
  // Resolve category name (not ID) and location name+ID
  const catVal = document.getElementById('addGrpCategory')?.value;
  const locVal = document.getElementById('addGrpLocation')?.value;
  const location_id = locVal ? parseInt(locVal, 10) : null;
  const category = catVal
    ? (CATEGORIES.find(c => String(c.id) === String(catVal))?.name || templateItem.category || '')
    : (templateItem.category || '');
  const location = location_id
    ? (LOCATIONS_LIST.find(l => l.id === location_id)?.name || templateItem.location || '')
    : (templateItem.location || '');
  const body = {
    name,
    category,
    location,
    location_id,
    model_id: templateItem.model_id || null,
    notes: notesEl?.value?.trim() || '',
    group_key: _openGroupKey,
  };
  if (serialEl?.value?.trim()) body.serial_number = serialEl.value.trim();
  if (barcodeEl?.value?.trim()) body.barcode = barcodeEl.value.trim();
  const btn = document.querySelector('#modalContent .btn-primary');
  if (btn) btn.disabled = true;
  try {
    const { item } = await api('/api/equipment', { method: 'POST', body });
    await loadItems();
    // Build group panel items: by group key + always include newly created item by ID
    const byKey = ITEMS.filter(i => getGroupKey(i.name) === _openGroupKey);
    const newItem = ITEMS.find(i => i.id === item.id);
    if (newItem && !byKey.find(i => i.id === newItem.id)) byKey.push(newItem);
    _openGroupItems = byKey;
    // Show label print step
    try {
      const label = await api(`/api/equipment/${item.id}/label`);
      _pendingPrint = { label, name: item.name, category: item.category || '', serial: item.serial_number || '' };
      showModal(`
        <div class="success-icon" style="margin-bottom:12px">✓</div>
        <div style="text-align:center;font-size:15px;font-weight:600;margin-bottom:16px">Item Added to Group</div>
        <div class="label-preview">
          <img class="qr-img" src="${label.qr_data_url}" alt="QR Code">
          <div class="label-info">
            <div style="font-size:9px;color:#888;text-transform:uppercase">CISTracker</div>
            <div style="font-weight:600;margin:2px 0">${esc(item.name)}</div>
            <div class="label-id">${esc(label.asset_id)}</div>
            <div style="font-size:10px;color:#666;margin-top:2px">${esc(item.category || '')}${item.serial_number ? ' · ' + item.serial_number : ''}</div>
          </div>
        </div>
        <div class="form-actions">
          <button class="btn-outline" onclick="closeModal(); openGroupDetail(_openGroupKey, _openGroupItems)">Skip</button>
          <button class="btn-primary" onclick="printPendingLabel(); openGroupDetail(_openGroupKey, _openGroupItems)">🖨 Print Label</button>
        </div>
      `);
    } catch {
      toast('Item added', 'success');
      closeModal();
      openGroupDetail(_openGroupKey, _openGroupItems);
    }
  } catch (err) {
    toast(err.error || 'Failed to add item', 'error');
    if (btn) btn.disabled = false;
  }
}

async function renameGroup(key, items) {
  const newName = prompt(`Rename group "${key}" to:`, key);
  if (!newName || !newName.trim() || newName.trim() === key) return;
  const trimmed = newName.trim();
  if (!confirm(`Rename "${key}" → "${trimmed}"?\nThis will update ${items.length} item name${items.length > 1 ? 's' : ''}.`)) return;
  let failed = 0;
  for (const item of items) {
    const updated = item.name.includes(key) ? item.name.replace(key, trimmed) : item.name;
    if (updated === item.name) continue;
    try { await api(`/api/equipment/${item.id}`, { method: 'PUT', body: { name: updated } }); }
    catch { failed++; }
  }
  if (failed) toast(`${failed} item(s) failed to rename`, 'error');
  else toast(`Group renamed to "${trimmed}"`, 'success');
  await loadItems();
  closeDetail();
}

async function moveItemToGroup(itemId) {
  const item = ITEMS.find(i => i.id === itemId);
  if (!item) return;
  const currentKey = _openGroupKey;
  const groupKeys = [...new Set(ITEMS.map(i => i.group_key || getGroupKey(i.name)))].filter(k => k !== currentKey).sort();
  const optionsHtml = groupKeys.map(k => `<option value="${esc(k)}">${esc(k)}</option>`).join('');
  showModal(`
    <div class="modal-title">Move Item</div>
    <div class="form-group">
      <label class="form-label">Item</label>
      <div style="font-size:13px;font-weight:600;padding:6px 0">${esc(item.name)}</div>
    </div>
    <div class="form-group">
      <label class="form-label">Move to group</label>
      <select id="moveGroupSelect" class="form-input" onchange="updateMoveNameSuggestion(${itemId})">
        <option value="">— No group (standalone) —</option>
        ${optionsHtml}
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">New item name</label>
      <input id="moveItemName" class="form-input" value="${esc(item.name)}">

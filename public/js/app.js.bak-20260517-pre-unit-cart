function renderGrouped() {
  const tbody = document.getElementById('itemsBody');
  const groups = new Map();
  for (const item of renderVisible) {
    const key = item.group_key || getGroupKey(item.name);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(item);
  }
  const frag = document.createDocumentFragment();
  for (const [key, items] of groups) {
    items.sort(naturalSort);
    if (items.length === 1) {
      frag.appendChild(makeItemRow(items[0], false));
    } else {
      frag.appendChild(makeGroupRow(key, items));
    }
  }
  tbody.appendChild(frag);
}

function makeGroupRow(key, items) {
  const tr = document.createElement('tr');
  tr.classList.add('group-row');
  tr._groupKey = key;
  const allSel = items.every(it => _selectedItems.has(it.id));
  const someSel = !allSel && items.some(it => _selectedItems.has(it.id));
  if (allSel) tr.className = 'row-selected';

  let availCount = 0, outCount = 0, overdueCount = 0;
  for (const it of items) {
    const st = getItemStatus(it);
    if (st === 'available') availCount++;
    else if (st === 'overdue') overdueCount++;
    else outCount++;
  }
  const total = items.length;
  const category = items[0].category || '—';
  const location = items[0].location || '—';

  let statusHtml;
  if (availCount === total) {
    statusHtml = `<span class="status-badge status-available"><span class="dot"></span>All Available</span>`;
  } else if (availCount === 0 && overdueCount > 0) {
    statusHtml = `<span class="status-badge status-overdue"><span class="dot"></span>${overdueCount} Overdue</span>`;
  } else if (availCount === 0) {
    statusHtml = `<span class="status-badge status-checked_out"><span class="dot"></span>All Out</span>`;
  } else {
    statusHtml = `<span class="status-badge status-available"><span class="dot"></span>${availCount} / ${total} avail</span>`;
  }

  const firstBarcode = items[0].barcode || 'CIS-' + String(items[0].id).padStart(6,'0');
  tr.innerHTML = `
    <td class="cb-cell"></td>
    <td class="cell-id">${esc(firstBarcode)}<div style="font-size:9px;color:var(--text-muted);margin-top:1px">+${total - 1} more</div></td>
    <td><div class="cell-name" style="font-weight:700">${esc(key)}</div></td>
    <td>${esc(category)}</td>
    <td>${esc(location)}</td>
    <td style="text-align:center;font-weight:600;color:var(--accent)">${total}</td>
    <td>${statusHtml}</td>
    <td class="cell-action"><span class="group-row-chevron">🛒</span></td>
  `;

  const cb = document.createElement('input');
  cb.type = 'checkbox';
  cb.className = 'row-cb';
  cb.checked = allSel;
  if (someSel) cb.indeterminate = true;
  cb.addEventListener('click', e => { e.stopPropagation(); toggleGroupSelect(key, e.target); });
  tr.querySelector('.cb-cell').appendChild(cb);
  tr.addEventListener('click', () => openGroupDetail(key, items));
  return tr;
}

function openGroupDetail(key, items) {
  _openGroupItems = [...items];
  _openGroupKey = key;
  // Reset selection state when switching panels so a previous panel's
  // anchor or selections can't bleed into this one.
  _groupPanelSelected.clear();
  _grpLastSelected = null;
  document.getElementById('detailOverlay').classList.add('open');
  const panel = document.getElementById('detailPanel');

  const sorted = [...items].sort(naturalSort);
  let availCount = 0, outCount = 0, overdueCount = 0;
  for (const it of sorted) {
    const st = getItemStatus(it);
    if (st === 'available') availCount++;
    else if (st === 'overdue') overdueCount++;
    else outCount++;
  }
  const total = sorted.length;
  const category = sorted[0]?.category || '—';
  const location = sorted[0]?.location || '—';

  // Status badge for the group header — matches openDetail pattern
  let badgeSt, badgeLabel;
  if (availCount === total) { badgeSt = 'available'; badgeLabel = 'Available'; }
  else if (availCount === 0 && overdueCount > 0) { badgeSt = 'overdue'; badgeLabel = 'Overdue'; }
  else if (availCount === 0) { badgeSt = 'checked_out'; badgeLabel = 'All Out'; }
  else { badgeSt = 'available'; badgeLabel = `${availCount} / ${total} Available`; }

  // Item cards — name is big, CIS-ID is small mono below, same card style as unit rows
  const isPriv = ME.role === 'admin' || ME.role === 'owner';

  function buildGroupCard(it) {
    const st = getItemStatus(it);
    const barcode = it.barcode || 'CIS-' + String(it.id).padStart(6,'0');
    const isAvail = st === 'available';
    const isOverdue = st === 'overdue';
    const actionBtn = isAvail
      ? `<button class="btn-cart${_cart.has(it.id) ? ' in-cart' : ''}" id="cartBtn-${it.id}" title="${_cart.has(it.id) ? 'Remove from cart' : 'Add to cart'}" onclick="event.stopPropagation();toggleCart(${it.id})">🛒</button>`
      : `<button class="btn-outline btn-sm btn-green" onclick="event.stopPropagation();openReturnModal(${it.id})">Return</button>`;
    const borrower = !isAvail && it.checked_out_username
      ? `<div style="font-size:10px;color:var(--${isOverdue?'red':'amber'});margin-top:1px">→ ${esc(it.checked_out_username)}</div>` : '';
    const privActions = `
      <div style="display:flex;gap:4px;margin-left:4px;flex-wrap:wrap">
        ${isPriv ? `<button class="btn-outline btn-sm" style="font-size:11px;padding:2px 7px" onclick="event.stopPropagation();closeDetail();editItem(${it.id})">Edit</button>` : ''}
        ${isPriv ? `<button class="btn-outline btn-sm" style="font-size:11px;padding:2px 7px" onclick="event.stopPropagation();moveItemToGroup(${it.id})">Move</button>` : ''}
        <button class="btn-outline btn-sm" style="font-size:11px;padding:2px 7px" onclick="event.stopPropagation();printLabel(${it.id})">Label</button>
      </div>`;

  for (const id of ids) {
    try {
      const label = await api(`/api/equipment/${id}/label`);
      const item = ITEMS.find(i => i.id === id);
      items.push({ qr: label.qr_data_url, id: label.asset_id, name: item?.name || '', serial: item?.serial_number || '', category: item?.category || '' });
    } catch {}
  }
  if (!items.length) return;
  const frame = document.createElement('iframe');
  frame.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:40mm;height:30mm;border:none;';
  document.body.appendChild(frame);

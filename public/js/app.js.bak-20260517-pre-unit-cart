        <button class="btn-outline btn-sm" id="grpAddExisting">+ Existing Item</button>
        <button class="btn-outline btn-sm" id="grpPrintAll">Print All Labels</button>
        ${isPriv ? `<button class="btn-outline btn-sm" id="grpRename">Rename Group</button>` : ''}
        ${isPriv ? `<button class="btn-outline btn-sm btn-red" id="grpDeleteAll">Delete All</button>` : ''}
      </div>
    </div>`;

  panel.innerHTML = `
    <div class="detail-header">
      <div>
        <span class="status-badge status-${badgeSt}"><span class="dot"></span>${badgeLabel}</span>
        <div class="detail-name" style="margin-top:8px">${esc(key)}</div>
        <div class="detail-id">Group · ${total} items</div>
      </div>
      <button class="close-btn" onclick="closeDetail()">✕</button>
    </div>
    <div class="detail-section">
      <h4>Details</h4>
      <div class="meta-row"><span class="label">Category</span><span class="value">${esc(category)}</span></div>
      <div class="meta-row"><span class="label">Location</span><span class="value">${esc(location)}</span></div>
      <div class="meta-row"><span class="label">Total</span><span class="value">${total} items</span></div>
      <div class="meta-row"><span class="label">Available</span><span class="value" style="color:var(--green)">${availCount}</span></div>
      ${outCount > 0 ? `<div class="meta-row"><span class="label">Checked Out</span><span class="value" style="color:var(--amber)">${outCount}</span></div>` : ''}
      ${overdueCount > 0 ? `<div class="meta-row"><span class="label">Overdue</span><span class="value" style="color:var(--red)">${overdueCount}</span></div>` : ''}
    </div>
    <div class="detail-section">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
        <h4 style="margin:0">Items</h4>
        <span style="font-size:11px;color:var(--text-muted)">${total} total</span>
      </div>
      ${total > 4 ? `<input id="grpSearch" type="search" class="form-input" placeholder="Search by name, ID, serial…" style="margin-bottom:8px;font-size:12px;padding:6px 10px" oninput="window._grpSearch(this.value.toLowerCase())">` : ''}
      <div id="grpItemList" style="display:flex;flex-direction:column;gap:4px">${itemRows}</div>
    </div>
    ${adminHtml}
  `;

  // Inject selection bar
  const selBar = document.createElement('div');
  selBar.id = 'grpSelBar';
  selBar.style.cssText = 'display:none;position:sticky;bottom:0;background:var(--bg-surface);border-top:1px solid var(--border);padding:10px 16px;gap:8px;align-items:center;z-index:10';
  selBar.innerHTML = `
    <span id="grpSelCount" style="font-size:13px;font-weight:500;flex:1"></span>
    <button class="btn-primary btn-sm" onclick="printGroupSelected()">Print Labels</button>
    <button class="btn-sm" style="font-size:12px;background:#d97706;color:#fff;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:600" onclick="reportGroupSelected()">Report Damage</button>
    ${isPriv ? `<button class="btn-sm" style="font-size:12px;background:#f04a5a;color:#fff;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:600" onclick="deleteGroupSelected()">Delete</button>` : ''}
    <button class="btn-sm" style="font-size:12px;background:var(--bg-elevated);color:var(--text-sec);border:1px solid var(--border-input);padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:500" onclick="_groupPanelSelected.clear();refreshGroupPanelSelection()">Clear</button>
  `;
  panel.appendChild(selBar);

  window._grpSearch = (q) => renderGroupItemList(q);

  const printBtn = panel.querySelector('#grpPrintAll');
  if (printBtn) printBtn.addEventListener('click', massPrintGroupItems);

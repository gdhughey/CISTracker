    if (!el) return;
    const matches = q
      ? sorted.filter(it => {
          const bc = it.barcode || 'CIS-' + String(it.id).padStart(6,'0');
          return it.name.toLowerCase().includes(q)
            || bc.toLowerCase().includes(q)
            || (it.serial_number || '').toLowerCase().includes(q)

async function submitBatchReservation(itemIds) {
  const start_date = document.getElementById('resStart')?.value;
  const end_date = document.getElementById('resEnd')?.value;
  const period = document.getElementById('resPeriod')?.value || 'allday';
  const notes = document.getElementById('resNotes')?.value || '';
  const forUserEl = document.getElementById('resForUser');
  const for_user_id = forUserEl?.value ? parseInt(forUserEl.value, 10) : undefined;
  if (!start_date || !end_date) { toast('Select start and end dates', 'error'); return; }
  if (end_date < start_date) { toast('End date must be on or after start date', 'error'); return; }
  const btn = document.getElementById('resSubmitBtn');
  if (btn) btn.disabled = true;
  let ok = 0, failed = [];
  for (const itemId of itemIds) {
    try {
      const body = { start_date, end_date, period, notes };
      if (for_user_id) body.for_user_id = for_user_id;
      await api(`/api/equipment/${itemId}/reserve`, { method: 'POST', body });
      ok++;
    } catch (err) {
      const item = ITEMS.find(i => i.id === itemId);
      failed.push(item?.name || `ID ${itemId}`);
    }
  }
  if (btn) btn.disabled = false;
  if (failed.length === 0) {
    toast(`${ok} reservation${ok !== 1 ? 's' : ''} created!`, 'success');
    closeModal();
    if (currentView === 'my-reservations') loadMyReservations();
    if (currentView === 'admin-reservations') loadAdminReservations();
  } else if (ok > 0) {
    toast(`${ok} created, ${failed.length} failed: ${failed.join(', ')}`, 'error');
    closeModal();
  } else {
    toast(`All reservations failed: ${failed.join(', ')}`, 'error');
  }
}


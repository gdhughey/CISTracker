  });
  const selBar = document.getElementById('unitSelBar');
  if (selBar) {
    const count = _unitPanelSelected.size;
    selBar.style.display = count > 0 ? 'flex' : 'none';
    const label = selBar.querySelector('#unitSelCount');
    if (label) label.textContent = `${count} selected`;
  }
}

async function printGroupSelected() {
  if (!_groupPanelSelected.size) return;
  const orig = new Set(_selectedItems);
  for (const id of _groupPanelSelected) _selectedItems.add(id);
  await massPrintLabels();
  _selectedItems.clear();
  for (const id of orig) _selectedItems.add(id);
}

async function deleteGroupSelected() {
  const ids = [..._groupPanelSelected];
  if (!ids.length) return;
  const names = ids.map(id => {
    const it = ITEMS.find(i => i.id === id);
    return it ? it.name : `ID ${id}`;
  });
  const preview = names.slice(0, 5).join('\n') + (names.length > 5 ? `\n…and ${names.length - 5} more` : '');
  if (!confirm(`Delete ${ids.length} item${ids.length > 1 ? 's' : ''}?\n\n${preview}\n\nThis cannot be undone.`)) return;
  _groupPanelSelected.clear();
  closeDetail();
  await confirmMassDelete(ids);
}


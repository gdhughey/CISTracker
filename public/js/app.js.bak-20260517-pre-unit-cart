    await api(`/api/equipment/${itemId}`, { method: 'PUT', body: { name: newName } });
    toast('Item added to group', 'success');
    closeModal();
    closeDetail();
    await loadItems();
  } catch (err) { toast(err.error || 'Failed to add item', 'error'); }
}

let _grpLastSelected = null;
let _unitLastSelected = null;

function toggleGroupPanelSelect(itemId, event) {
  const cards = [...document.querySelectorAll('#detailPanel .grp-card[data-item-id]')];
  const idx = cards.findIndex(c => parseInt(c.dataset.itemId) === itemId);
  if (idx < 0) return; // clicked card not in current panel — defensive no-op

  // Shift-range select requires a valid anchor that still exists in this panel.
  const lastIdx = _grpLastSelected !== null
    ? cards.findIndex(c => parseInt(c.dataset.itemId) === _grpLastSelected)
    : -1;

  if (event && event.shiftKey && lastIdx >= 0) {
    event.preventDefault(); // stop browser text-selection on shift+click
    const [from, to] = lastIdx < idx ? [lastIdx, idx] : [idx, lastIdx];
    const adding = !_groupPanelSelected.has(itemId);
    for (let i = from; i <= to; i++) {
      const id = parseInt(cards[i].dataset.itemId);
      if (adding) _groupPanelSelected.add(id);
      else _groupPanelSelected.delete(id);
    }
  } else {
    if (_groupPanelSelected.has(itemId)) _groupPanelSelected.delete(itemId);
    else _groupPanelSelected.add(itemId);
    _grpLastSelected = itemId;
  }
  refreshGroupPanelSelection();
}

function refreshGroupPanelSelection() {
  document.querySelectorAll('#detailPanel .grp-card[data-item-id]').forEach(card => {
    const id = parseInt(card.dataset.itemId);
    const sel = _groupPanelSelected.has(id);
    card.classList.toggle('grp-card-selected', sel);
    const cb = card.querySelector('.grp-cb');
    if (cb) cb.checked = sel;
  });
  const selBar = document.getElementById('grpSelBar');
  if (selBar) {
    const count = _groupPanelSelected.size;
    selBar.style.display = count > 0 ? 'flex' : 'none';
    const label = selBar.querySelector('#grpSelCount');
    if (label) label.textContent = `${count} selected`;
  }
}
function toggleUnitPanelSelect(unitId, event) {
  if (_unitPanelSelected.has(unitId)) _unitPanelSelected.delete(unitId);
  else _unitPanelSelected.add(unitId);
  _unitLastSelected = unitId;
  refreshUnitPanelSelection();
}

function refreshUnitPanelSelection() {
  document.querySelectorAll('#detailPanel .grp-card[data-unit-id]').forEach(card => {
    const id = parseInt(card.dataset.unitId);
    const sel = _unitPanelSelected.has(id);
    card.classList.toggle('grp-card-selected', sel);

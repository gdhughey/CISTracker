function openDamageReportModal(itemId) {
  const item = ITEMS.find(i => i.id === itemId);
  if (!item) return;
  showModal(`
    <div class="modal-title">Report Condition Issue</div>
    <div class="modal-name">${esc(item.name)}</div>
    <div class="modal-body" style="margin-top:12px">
      <div class="form-group">
        <label class="form-label">Describe the issue</label>
        <textarea id="dmgNotes" rows="3" class="form-input" maxlength="500"
          placeholder="e.g. cracked screen, missing key…" style="width:100%;resize:vertical"></textarea>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:16px">
        <input type="checkbox" id="severeCb">
        Mark as severely damaged (out of service)
      </label>
      <div class="form-actions">

// ── My Queue view ──────────────────────────────────────────────────────
async function loadMyEquipment() {
  const container = document.getElementById('myEquipmentList');
  if (!container) return;
  const isAdmin = ME && (ME.role === 'admin' || ME.role === 'owner');
  const selEl = document.getElementById('myEquipUserSel');
  const userId = (isAdmin && selEl && selEl.value) ? parseInt(selEl.value, 10) : ME.id;
  container.innerHTML = '<div style="color:var(--text-muted);font-size:13px;padding:12px 0">Loading…</div>';
  try {
    const { items } = await api('/api/equipment');
    const mine = items.filter(i =>
      (i.status === 'checked_out' || i.status === 'overdue' || i.checkout_type === 'am' || i.checkout_type === 'pm')
      && i.checked_out_by === userId
    );
    if (!mine.length) {
      container.innerHTML = '<div class="empty-state"><p>No items currently checked out.</p></div>';
      return;
    }
    container.innerHTML = mine.map(item => {
      const st = getItemStatus(item);
      const lbl = statusLabel(st);
      const due = item.due_date
        ? new Date(item.due_date + 'T12:00:00Z').toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' })
        : (item.checkout_type === 'am' ? 'Auto-returns ' + (_periodSettings.am_end_time || '11:30')
          : item.checkout_type === 'pm' ? 'Auto-returns ' + (_periodSettings.pm_end_time || '15:00')
          : 'No due date');
      const typeBadge = item.checkout_type && item.checkout_type !== 'allday'
        ? '<span style="font-size:10px;font-weight:600;padding:2px 6px;border-radius:4px;background:rgba(251,191,36,0.12);color:var(--amber);border:1px solid rgba(251,191,36,0.2);margin-left:6px">' + item.checkout_type.toUpperCase() + '</span>'
        : '';
      return '<div class="user-row" style="align-items:center;gap:12px">'
        + '<div style="flex:1;min-width:0">'
        + '<div style="font-size:14px;font-weight:600;display:flex;align-items:center;gap:4px">' + esc(item.name) + typeBadge + '</div>'
        + '<div style="font-size:11px;color:var(--text-muted);margin-top:2px;font-family:var(--mono)">' + esc(item.barcode || 'ID-' + item.id) + '</div>'
        + '</div>'
        + '<div style="text-align:right;flex-shrink:0">'
        + '<span class="status-badge status-' + st + '"><span class="dot"></span>' + lbl + '</span>'
        + '<div style="font-size:11px;color:var(--text-muted);margin-top:4px">' + due + '</div>'
        + '</div>'
        + '<button class="btn-outline btn-sm btn-green" onclick="openReturnModal(' + item.id + ')">Return</button>'
        + '</div>';
    }).join('');
    // Show admin user selector
    const ctrl = document.getElementById('myEquipAdminCtrl');
    if (ctrl) ctrl.style.display = isAdmin ? 'block' : 'none';
    if (isAdmin && selEl && selEl.options.length <= 1) loadMyEquipmentAdminSelect();
  } catch {
    container.innerHTML = '<div class="empty-state"><p>Failed to load equipment</p></div>';
  }
}


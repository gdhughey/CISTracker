async function loadRepairQueue() {
  const section = document.getElementById('repairQueueSection');
  const container = document.getElementById('repairQueue');
  if (!container) return;
  const isMeAdmin = ME && (ME.role === 'admin' || ME.role === 'owner');
  if (!isMeAdmin) { if (section) section.style.display = 'none'; return; }
  const allItems = await api('/api/equipment');
  const damaged = (allItems?.items || []).filter(i =>
    i.status === 'needs_repair' || i.status === 'damaged');
  if (section) section.style.display = damaged.length ? 'block' : 'none';
  if (!damaged.length) {
    container.innerHTML = '<div class="empty-state">No items needing repair.</div>';
    return;
  }
  container.innerHTML = damaged.map(i => `
    <div class="repair-row">
      <div>
        <strong>${esc(i.name)}</strong>
        <span class="status-badge status-${esc(i.status)}" style="margin-left:8px">${esc(statusLabel(i.status))}</span>
        ${i.condition_notes ? `<div class="condition-notes">${esc(i.condition_notes)}</div>` : ''}
      </div>
      <button class="btn-outline btn-green btn-sm" onclick="doMarkRepaired(${i.id})">Mark Repaired</button>
    </div>
  `).join('');
}

async function doMarkRepaired(itemId) {
  const r = await api(`/api/equipment/${itemId}/repair`, {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({})
  });
  if (r?.error) { toast(r.error, 'error'); return; }
  toast('Marked as repaired');
  loadRepairQueue();
  loadRepairsView();
  loadItems();
}


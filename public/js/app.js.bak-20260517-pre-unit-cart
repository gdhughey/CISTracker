        <button class="btn-outline btn-red" onclick="submitDamageReport(${itemId})">Submit Report</button>
      </div>
    </div>
  `, { persistent: true });
}

async function submitDamageReport(itemId) {
  const notes = document.getElementById('dmgNotes')?.value?.trim() || '';
  const severe = document.getElementById('severeCb')?.checked || false;
  if (!notes) { toast('Please describe the issue', 'error'); return; }
  try {
    const r = await api(`/api/equipment/${itemId}/damage`, {
      method: 'POST',
      body: { condition_notes: notes, severe }
    });
    if (r?.error) { toast(r.error, 'error'); return; }
    toast('Condition report submitted');
    closeModal();
    loadItems();
    loadRepairQueue();
  } catch (err) {
    toast(err?.error || err?.message || 'Failed to submit report', 'error');
  }
}


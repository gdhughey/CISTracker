function renderAuditList() {
  const el = document.getElementById('auditRows');
  if (!el) return;
  const filterSet = AUDIT_FILTER_GROUPS[_auditFilter];
  const q = _auditSearch.toLowerCase();
  const visible = _auditEntries.filter(e => {
    if (filterSet && !filterSet.includes(e.action)) return false;
    if (q) {
      const label = (AUDIT_ACTION_LABELS[e.action] || e.action).toLowerCase();
      const target = (e.target || '').toLowerCase();
      const user = (e.username || '').toLowerCase();
      const detail = (e.details || '').toLowerCase();
      if (!label.includes(q) && !target.includes(q) && !user.includes(q) && !detail.includes(q)) return false;
    }
    return true;
  });
  if (!visible.length) { el.innerHTML = '<div class="empty-state"><p>No matching entries</p></div>'; return; }
  el.innerHTML = visible.map(e => {
    const color = AUDIT_ACTION_COLOR[e.action] || 'var(--text-sec)';
    const targetHtml = e.target
      ? `<a href="#" class="audit-link" onclick="handleAuditTarget(event,${JSON.stringify(e.action)},${JSON.stringify(e.target)})">${esc(e.target)}</a>`
      : '';
    const userHtml = e.username
      ? `<a href="#" class="audit-link" onclick="openUserFromAudit(event,${e.user_id || 0})">${esc(e.username)}</a>`
      : '—';
    const isLogin = LOGIN_ACTIONS.has(e.action);
    const ipHtml = isLogin && e.ip_address ? `<span class="audit-ip">📍 ${esc(e.ip_address)}</span>` : '';
    const deviceHtml = isLogin && e.user_agent ? `<span class="audit-device">${esc(parseUserAgent(e.user_agent))}</span>` : '';
    let detailHtml = '';
    if (e.details) {
      try {
        const d = JSON.parse(e.details);
        const parts = [];
        if (d.name) parts.push(`<strong>${esc(d.name)}</strong>`);
        if (d.for_user) parts.push(`for ${esc(d.for_user)}`);
        if (d.count !== undefined) parts.push(`${d.count} item${d.count !== 1 ? 's' : ''}`);
        if (d.serial) parts.push(`S/N: ${esc(d.serial)}`);
        if (d.barcode) parts.push(`ID: ${esc(d.barcode)}`);
        if (d.category) parts.push(esc(d.category));
        if (d.location) parts.push(`@ ${esc(d.location)}`);
        if (d.newRole) parts.push(`→ <strong>${esc(d.newRole)}</strong>`);
        if (d.role && !d.newRole) parts.push(`role: ${esc(d.role)}`);
        if (d.group) parts.push(`group: ${esc(d.group)}`);
        if (d.oldEmail && d.newEmail) parts.push(`${esc(d.oldEmail)} → ${esc(d.newEmail)}`);
        if (d.old_name && d.new_name) parts.push(`${esc(d.old_name)} → ${esc(d.new_name)}`);
        if (d.due_date) parts.push(`due ${esc(d.due_date)}`);
        if (parts.length) detailHtml = parts.join(' · ');
      } catch {}
    }
    return `
      <div class="audit-row" style="border-left:3px solid ${color}">
        <div class="audit-row-main">
          <span class="action" style="color:${color}">${esc(AUDIT_ACTION_LABELS[e.action] || e.action)}</span>
          ${targetHtml ? `<span class="target">${targetHtml}</span>` : ''}
          ${detailHtml ? `<span class="audit-detail">${detailHtml}</span>` : '<span class="ar-spacer"></span>'}
          <span class="ar-who">${userHtml}</span>
          <span class="date">${fmtDateTime(e.created_at)}</span>
        </div>
        ${ipHtml || deviceHtml ? `<div class="audit-row-sub audit-meta">${ipHtml}${deviceHtml}</div>` : ''}
      </div>`;
  }).join('');
}

function handleAuditTarget(e, action, target) {
  e.preventDefault();
  const equipmentActions = ['checkout','checkin','equipment_create','equipment_update','equipment_delete','clear_log'];
  if (equipmentActions.includes(action)) {
    const id = parseInt(target, 10);
    if (!isNaN(id)) { openDetail(id); return; }
  }
}

async function openUserFromAudit(e, userId) {
  e.preventDefault();
  if (!userId) return;
  try {
    switchView('users');
    setTimeout(() => openUserDetail(userId), 300);
  } catch { toast('Failed to open user', 'error'); }
}


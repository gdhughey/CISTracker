  // Multiple items — shared description
  const names = ids.map(id => { const it = ITEMS.find(i => i.id === id); return it ? it.name : `ID ${id}`; });
  showModal(`
    <div class="modal-title">Report Damage</div>
    <div style="font-size:12px;color:var(--text-muted);margin-bottom:12px">${ids.length} items selected</div>
    <div class="form-group">
      <label class="form-label">Describe the issue</label>
      <textarea id="grpDmgNotes" rows="3" class="form-input" maxlength="500"
        placeholder="e.g. cracked screen, missing key…" style="width:100%;resize:vertical"></textarea>

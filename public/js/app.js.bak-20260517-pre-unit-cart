async function checkReservationAvailability(itemId) {
  const start = document.getElementById('resStart')?.value;
  const end = document.getElementById('resEnd')?.value;
  const period = document.getElementById('resPeriod')?.value || 'allday';
  const msg = document.getElementById('resAvailMsg');
  if (!start || !end) { if (msg) msg.textContent = 'Select dates first.'; return; }
  if (msg) msg.innerHTML = '<span style="color:var(--text-muted)">Checking…</span>';
  const r = await api(`/api/equipment/${itemId}/availability?start=${start}&end=${end}&period=${period}`);
  if (!msg) return;
  if (r?.available) {
    msg.innerHTML = '<span style="color:var(--green)">✓ Available for that period</span>';
  } else {
    msg.innerHTML = `<span style="color:var(--red)">✗ Not available: ${esc(r?.reason || 'conflict')}</span>`;
  }
}

async function submitReservation(itemId) {
  const start_date = document.getElementById('resStart')?.value;
  const end_date = document.getElementById('resEnd')?.value;
  const period = document.getElementById('resPeriod')?.value || 'allday';
  const notes = document.getElementById('resNotes')?.value || '';
  if (!start_date || !end_date) { toast('Select start and end dates', 'error'); return; }
  if (end_date < start_date) { toast('End date must be on or after start date', 'error'); return; }
  const btn = document.getElementById('resSubmitBtn');
  if (btn) btn.disabled = true;
  try {
    await api(`/api/equipment/${itemId}/reserve`, {
      method: 'POST',
      body: { start_date, end_date, period, notes }
    });
    toast('Reservation created!', 'success');
    closeModal();
    if (currentView === 'my-reservations') loadMyReservations();

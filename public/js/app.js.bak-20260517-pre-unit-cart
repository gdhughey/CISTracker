      }
    } else {
      await api('/api/service-tickets', {
        method: 'POST',
        body: { type: 'add_item', payload: units ? { ...basePayload, units, quantity: qty } : payload },
      });
      toast('Request submitted — pending admin approval', 'success');
      closeModal();
    }
  } catch (err) { toast(err.error || 'Failed', 'error'); }
}


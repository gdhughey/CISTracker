# Server
NODE_ENV=development
PORT=3000
TRUST_PROXY=true

# Session secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET=replace-me-with-64-random-chars
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8

# Database
DB_PATH=./data/cyberlab.db

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Account creation
ALLOW_REGISTRATION=false

# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Password rules
PASSWORD_MIN_LENGTH=10

# Bcrypt cost
BCRYPT_COST=12

# Vision (Ollama + optional Sonnet fallback)
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=

# Email (SMTP for password recovery + overdue alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CyberLab <cyberlab@example.com>"

# Reminders
REMINDER_DAYS=3
ALERT_DAYS=5
REMINDER_CRON=0 9 * * *

# Public app URL (used in password reset emails)
APP_URL=http://localhost:3000

# Initial admin (used by `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026

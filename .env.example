# Server
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Session secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-me-with-64-random-chars
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8

# Set to true once nginx/Cloudflare is terminating TLS for this app
TLS_ENABLED=false

# Database
DB_PATH=./data/cyberlab.db

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Self-registration (admins create accounts manually otherwise)
ALLOW_REGISTRATION=false

# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Password rules
PASSWORD_MIN_LENGTH=10

# Bcrypt cost
BCRYPT_COST=12

# Email (Resend — get an API key at resend.com)
RESEND_API_KEY=
RESEND_NOREPLY_FROM=CISTracker <noreply@cistracker.net>
RESEND_SUPPORT_FROM=CISTracker Support <support@cistracker.net>
# Where new support tickets get forwarded
RESEND_SUPPORT_FORWARD=
# Where to send the alert when an admin drops a ticket without resolving it
RESEND_DROPPED_FORWARD=

# Reminder schedule (overdue items)
REMINDER_DAYS=3
ALERT_DAYS=5
REMINDER_CRON=0 9 * * *

# Public app URL (used in password reset emails + boot banner)
APP_URL=https://cistracker.net

# Initial admin (used by `npm run seed`)
# Leave SEED_ADMIN_PASSWORD blank to auto-generate a strong random one
# (printed once during the seed run — copy it then).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Cloudflare Tunnel token (paste from the Zero Trust dashboard if using
# the install-cistracker.sh tunnel setup)
CLOUDFLARED_TOKEN=
